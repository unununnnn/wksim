<launch>
  <!-- Closed static contract for ego-single-box-v1.  Geometry, waypoint,
       limits, and the single cloud input are intentionally not launch args.
       world is the upstream frame spelling for the profile's map frame. -->
  <!-- main node -->
  <node pkg="ego_planner" name="uav1_ego_planner_node" type="ego_planner_node" output="screen">
    <!-- odom话题 -->
    <remap from="~odom_world" to="/uav1/prometheus/odom"/>
    <!-- 发布的B样条话题 -->
    <remap from="~planning/bspline" to = "/uav1/planning/bspline"/>
    <!-- 显示话题 -->
    <remap from="~planning/data_display" to = "/uav1/planning/data_display"/>
    <!-- 发布 广播的B样条 -->
    <remap from="~planning/broadcast_bspline_from_planner" to = "/broadcast_bspline"/>
    <!-- 订阅 广播的B样条 -->
    <remap from="~planning/broadcast_bspline_to_planner" to = "/broadcast_bspline"/>

    <!-- 地图中的odom话题 -->
    <remap from="~grid_map/odom" to="/uav1/prometheus/odom"/>
    <!-- 地图中点云话题 -->
    <!-- <remap from="~grid_map/cloud" to="/uav1/map_generator/global_cloud"/> -->
    <remap from="~grid_map/cloud" to="/map_generator/global_cloud"/>
    <!-- 地图中点云话题 -->
    <remap from="~grid_map/scan" to="/uav1/prometheus/scan"/>
    <!-- 地图中相机位姿话题 -->
    <remap from="~grid_map/pose"   to = "/depth/no_set"/>
    <!-- 地图中相机深度话题 -->
    <remap from="~grid_map/depth" to = "/depth/image_rect_raw"/>

    <param name="grid_map/uav_id" value="1" type="int"/>
    <!-- planning fsm -->
    <!-- 不同的目标点给定方式 -->
    <param name="fsm/flight_type" value="2" type="int"/>
    <!-- 重规划时间间隔，如果要增大规划频率，则减小该数值 -->
    <param name="fsm/thresh_replan_time" value="1.0" type="double"/>
    <!-- 重规划阈值：距离终点小于该阈值时，停止规划 -->
    <!-- waypoint yuzhi -->
    <param name="fsm/thresh_no_replan_meter" value="0.2" type="double"/>
    <!-- 规划范围 -->
    <param name="fsm/planning_horizon" value="13.5" type="double"/> <!--always set to 1.5 times grater than sensing horizen-->
    <!-- 紧急停止时间 -->
    <param name="fsm/emergency_time" value="1.0" type="double"/>
    <!-- 仿真与实际标志位，实际中需要等待一个起始话题 -->
    <param name="fsm/realworld_experiment" value="false" type="bool"/>
    <param name="fsm/fail_safe" value="true" type="bool"/>
    <!-- 路径点 -->
    <param name="fsm/waypoint_num" value="1" type="int"/>
    <param name="fsm/waypoint0_x" value="4.0" type="double"/>
    <param name="fsm/waypoint0_y" value="0.0" type="double"/>
    <param name="fsm/waypoint0_z" value="3.0" type="double"/>
    <!-- GridMap参数 -->
    <!-- 分辨率、地图尺寸 -->
    <param name="grid_map/resolution"      value="0.1" type="double"/>
    <param name="grid_map/map_size_x"   value="20.0" type="double"/>
    <param name="grid_map/map_size_y"   value="12.0" type="double"/>
    <param name="grid_map/map_size_z"   value="6.0" type="double"/>
    <param name="grid_map/map_origin_x"   value="-10.0" type="double"/>
    <param name="grid_map/map_origin_y"   value="-6.0" type="double"/>
    <!-- 地图更新距离 -->
    <!-- 点云数据会在特定范围内截断，只使用特定范围的信息，超出范围的数据丢弃 -->
    <param name="grid_map/local_update_range_x"  value="9.0" type="double"/>
    <param name="grid_map/local_update_range_y"  value="7.0" type="double"/>
    <param name="grid_map/local_update_range_z"  value="6.0" type="double"/>
    <!-- 膨胀距离 -->
    <param name="grid_map/obstacles_inflation"     value="0.8" type="double"/>
    <param name="grid_map/local_map_margin" value="10" type="int"/>
    <!-- ground_height -->
    <param name="grid_map/ground_height"        value="0.0" type="double"/>
    <!-- camera parameter -->
    <param name="grid_map/cx" value="321.04638671875" type="double"/>
    <param name="grid_map/cy" value="243.44969177246094" type="double"/>
    <param name="grid_map/fx" value="387.229248046875" type="double"/>
    <param name="grid_map/fy" value="387.229248046875" type="double"/>
    <!-- depth filter -->
    <param name="grid_map/use_depth_filter" value="true" type="bool"/>
    <param name="grid_map/depth_filter_tolerance" value="0.15" type="double"/>
    <param name="grid_map/depth_filter_maxdist"   value="5.0" type="double"/>
    <param name="grid_map/depth_filter_mindist"   value="0.2" type="double"/>
    <param name="grid_map/depth_filter_margin"    value="2" type="int"/>
    <param name="grid_map/k_depth_scaling_factor" value="1000.0" type="double"/>
    <param name="grid_map/skip_pixel" value="2" type="int"/>
    <!-- local fusion -->
    <param name="grid_map/p_hit"  value="0.65" type="double"/>
    <param name="grid_map/p_miss" value="0.35" type="double"/>
    <param name="grid_map/p_min"  value="0.12" type="double"/>
    <param name="grid_map/p_max"  value="0.90" type="double"/>
    <param name="grid_map/p_occ"  value="0.80" type="double"/>
    <param name="grid_map/min_ray_length" value="0.1" type="double"/>
    <param name="grid_map/max_ray_length" value="4.5" type="double"/>

    <param name="grid_map/virtual_ceil_height"   value="5.5" type="double"/>
    <param name="grid_map/visualization_truncate_height"   value="5.5" type="double"/>
    <param name="grid_map/show_occ_time"  value="false" type="bool"/>
    <!-- pose_type 里程计的类型 -->
    <param name="grid_map/pose_type"     value="2" type="int"/>
    <!-- 地图frame -->
    <param name="grid_map/frame_id"      value="world" type="string"/>

    <!-- planner manager -->
    <!-- 最大速度 -->
    <param name="manager/max_vel" value="0.8" type="double"/>
    <!-- 最大加速度 -->
    <param name="manager/max_acc" value="6.0" type="double"/>
    <param name="manager/control_points_distance" value="0.4" type="double"/>
    <param name="manager/feasibility_tolerance" value="0.05" type="double"/>
    <param name="manager/planning_horizon" value="13.5" type="double"/>
    <param name="manager/use_distinctive_trajs" value="true" type="bool"/>
    <param name="manager/drone_id" value="1" type="int"/>

    <!-- B样条优化参数 -->
    <!-- 平滑系数 -->
    <param name="optimization/lambda_smooth" value="1.0" type="double"/>
    <!-- 避障系数 -->
    <param name="optimization/lambda_collision" value="0.5" type="double"/>
    <!-- 可行性系数 -->
    <param name="optimization/lambda_feasibility" value="0.1" type="double"/>
    <!-- ? -->
    <param name="optimization/lambda_fitness" value="1.0" type="double"/>
    <param name="optimization/dist0" value="0.5" type="double"/>
    <param name="optimization/swarm_clearance" value="0.5" type="double"/>
    <param name="optimization/max_vel" value="0.8" type="double"/>
    <param name="optimization/max_acc" value="6.0" type="double"/>
  </node>

</launch>
