+}
+
+long long wksim_wall_ns()
+{
+	struct timespec ts {};
+	if (::syscall(SYS_clock_gettime, CLOCK_MONOTONIC, &ts) != 0) { return 0; }
+	return static_cast<long long>(ts.tv_sec) * 1000000000LL + ts.tv_nsec;
+}
