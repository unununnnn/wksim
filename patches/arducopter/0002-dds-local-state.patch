diff --git a/Tools/ros2/ardupilot_msgs/msg/WksimState.msg b/Tools/ros2/ardupilot_msgs/msg/WksimState.msg
new file mode 100644
index 0000000..610801f
--- /dev/null
+++ b/Tools/ros2/ardupilot_msgs/msg/WksimState.msg
@@ -0,0 +1,32 @@
+# Optional wksim SITL extension, not an upstream ArduPilot interface.
+# AHRS fields are sampled under its semaphore. GPS fields are a separate sample.
+# header uses boot time, not RTC/Unix or a joint-scene authority.
+std_msgs/Header header
+uint64 time_boot_us
+bool filter_status_valid
+uint32 filter_status
+bool ahrs_healthy
+bool attitude_valid
+bool position_valid
+bool velocity_valid
+bool home_valid
+# ENU relative to current home; quaternion FLU -> ENU, Hamilton XYZW.
+# Invalid pose/twist fields are zeroed, NEVER valid without their flags.
+geometry_msgs/Pose pose
+# Linear ENU, angular body FLU, SI units.
+geometry_msgs/Twist twist
+# Native Location values: degrees * 1e7, altitude cm in AP ABSOLUTE frame.
+# This does not claim a WGS84 ellipsoid height.
+int32 home_latitude_e7
+int32 home_longitude_e7
+int32 home_altitude_cm
+# Last EKF reset boot milliseconds; zero means no reset reported by backend.
+uint32 yaw_reset_ms
+uint32 position_ne_reset_ms
+uint32 position_down_reset_ms
+# Raw primary GPS quality/location, not EKF/home coordinates.
+uint8 gps_fix_type
+uint8 gps_num_sats
+int32 gps_latitude_e7
+int32 gps_longitude_e7
+int32 gps_altitude_cm
diff --git a/libraries/AP_DDS/Idl/ardupilot_msgs/msg/WksimState.idl b/libraries/AP_DDS/Idl/ardupilot_msgs/msg/WksimState.idl
new file mode 100644
index 0000000..dfb0a28
--- /dev/null
+++ b/libraries/AP_DDS/Idl/ardupilot_msgs/msg/WksimState.idl
@@ -0,0 +1,33 @@
+// Optional wksim SITL interface; matches Tools/ros2/ardupilot_msgs/msg/WksimState.msg.
+#include "std_msgs/msg/Header.idl"
+#include "geometry_msgs/msg/Pose.idl"
+#include "geometry_msgs/msg/Twist.idl"
+
+module ardupilot_msgs {
+  module msg {
+    struct WksimState {
+      std_msgs::msg::Header header;
+      uint64 time_boot_us;
+      boolean filter_status_valid;
+      uint32 filter_status;
+      boolean ahrs_healthy;
+      boolean attitude_valid;
+      boolean position_valid;
+      boolean velocity_valid;
+      boolean home_valid;
+      geometry_msgs::msg::Pose pose;
+      geometry_msgs::msg::Twist twist;
+      int32 home_latitude_e7;
+      int32 home_longitude_e7;
+      int32 home_altitude_cm;
+      uint32 yaw_reset_ms;
+      uint32 position_ne_reset_ms;
+      uint32 position_down_reset_ms;
+      uint8 gps_fix_type;
+      uint8 gps_num_sats;
+      int32 gps_latitude_e7;
+      int32 gps_longitude_e7;
+      int32 gps_altitude_cm;
+    };
+  };
+};
