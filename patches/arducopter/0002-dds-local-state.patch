diff --git a/libraries/AP_DDS/AP_DDS_Client.cpp b/libraries/AP_DDS/AP_DDS_Client.cpp
index c695728..bc903b8 100644
--- a/libraries/AP_DDS/AP_DDS_Client.cpp
+++ b/libraries/AP_DDS/AP_DDS_Client.cpp
@@ -50,6 +50,91 @@
 
 #define STRCPY(D,S) strncpy(D, S, ARRAY_SIZE(D))
 
+#if AP_DDS_WKSIM_STATE_ENABLED
+void AP_DDS_Client::update_topic(ardupilot_msgs_msg_WksimState& msg)
+{
+    // Never retain a prior coordinate when a getter fails on this sample.
+    msg = {};
+    {
+        auto &ahrs = AP::ahrs();
+        WITH_SEMAPHORE(ahrs.get_semaphore());
+        msg.time_boot_us = AP_HAL::micros64();
+        msg.header.stamp.sec = msg.time_boot_us / 1000000ULL;
+        msg.header.stamp.nanosec = (msg.time_boot_us % 1000000ULL) * 1000UL;
+        STRCPY(msg.header.frame_id, "map");
+        nav_filter_status status{};
+        msg.filter_status_valid = ahrs.get_filter_status(status);
+        msg.filter_status = status.value;
+        msg.ahrs_healthy = ahrs.healthy();
+        const auto &home = ahrs.get_home();
+        msg.home_valid = ahrs.home_is_set() && home.get_alt_cm(Location::AltFrame::ABSOLUTE, msg.home_altitude_cm);
+        if (msg.home_valid) {
+            msg.home_latitude_e7 = home.lat;
+            msg.home_longitude_e7 = home.lng;
+        }
+        Vector3f position;
+        msg.position_valid = msg.home_valid && ahrs.get_relative_position_NED_home(position)
+            && msg.filter_status_valid && status.flags.horiz_pos_abs && status.flags.vert_pos
+            && !status.flags.const_pos_mode && !status.flags.dead_reckoning && !status.flags.gps_glitching;
+        if (msg.position_valid) {
+            msg.pose.position.x = position.y;
+            msg.pose.position.y = position.x;
+            msg.pose.position.z = -position.z;
+        }
+        Vector3f velocity;
+        msg.velocity_valid = ahrs.get_velocity_NED(velocity) && msg.filter_status_valid
+            && status.flags.horiz_vel && status.flags.vert_vel;
+        if (msg.velocity_valid) {
+            msg.twist.linear.x = velocity.y;
+            msg.twist.linear.y = velocity.x;
+            msg.twist.linear.z = -velocity.z;
+        }
+        Quaternion q;
+        msg.attitude_valid = ahrs.get_quaternion(q) && msg.filter_status_valid && status.flags.attitude;
+        if (msg.attitude_valid) {
+            const float k = sqrtF(0.5);
+            msg.pose.orientation.w = k * (q[0] + q[3]);
+            msg.pose.orientation.x = k * (q[1] + q[2]);
+            msg.pose.orientation.y = k * (q[1] - q[2]);
+            msg.pose.orientation.z = k * (q[0] - q[3]);
+            const Vector3f gyro = ahrs.get_gyro();
+            msg.twist.angular.x = gyro.x;
+            msg.twist.angular.y = -gyro.y;
+            msg.twist.angular.z = -gyro.z;
+        }
+        float delta;
+        Vector2f delta_ne;
+        msg.yaw_reset_ms = ahrs.getLastYawResetAngle(delta);
+        msg.position_ne_reset_ms = ahrs.getLastPosNorthEastReset(delta_ne);
+        msg.position_down_reset_ms = ahrs.getLastPosDownReset(delta);
+    }
+    {
+        auto &gps = AP::gps();
+        WITH_SEMAPHORE(gps.get_semaphore());
+        msg.gps_fix_type = gps.status();
+        msg.gps_num_sats = gps.num_sats();
+        const auto &location = gps.location();
+        msg.gps_latitude_e7 = location.lat;
+        msg.gps_longitude_e7 = location.lng;
+        msg.gps_altitude_cm = location.alt;
+    }
+}
+
+void AP_DDS_Client::write_wksim_state_topic()
+{
+    if (!connected) {
+        return;
+    }
+    ucdrBuffer ub{};
+    const uint32_t size = ardupilot_msgs_msg_WksimState_size_of_topic(&wksim_state_topic, 0);
+    if (uxr_prepare_output_stream(&session, reliable_out,
+            topics[to_underlying(TopicIndex::WKSIM_STATE_PUB)].dw_id, &ub, size)
+        && !ardupilot_msgs_msg_WksimState_serialize_topic(&ub, &wksim_state_topic)) {
+        GCS_SEND_TEXT(MAV_SEVERITY_ERROR, "%s WksimState serialize fail", msg_prefix);
+    }
+}
+#endif
+
 // Enable DDS at runtime by default
 static constexpr uint8_t ENABLED_BY_DEFAULT = 1;
 #if AP_DDS_TIME_PUB_ENABLED
@@ -1874,6 +1959,13 @@ void AP_DDS_Client::update()
     }
 #endif // AP_DDS_STATUS_PUB_ENABLED
 
+#if AP_DDS_WKSIM_STATE_ENABLED
+    if (cur_time_ms - last_wksim_state_ms >= 20) {
+        update_topic(wksim_state_topic);
+        last_wksim_state_ms = cur_time_ms;
+        write_wksim_state_topic();
+    }
+#endif
     status_ok = uxr_run_session_time(&session, 1);
 }
 
