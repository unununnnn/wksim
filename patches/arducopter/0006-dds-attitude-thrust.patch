+bool AP_ExternalControl_Copter::set_attitude_and_thrust(const Quaternion& attitude_ned_frd, float thrust_norm)
+{
+    // Explicit native option is a prerequisite; never reinterpret demand as climb rate.
+    // All rejection happens before changing Guided submode, target or timestamp.
+    if (!ready_for_external_control() || !copter.mode_guided.set_attitude_target_provides_thrust() ||
+        !std::isfinite(attitude_ned_frd.q1) || !std::isfinite(attitude_ned_frd.q2) ||
+        !std::isfinite(attitude_ned_frd.q3) || !std::isfinite(attitude_ned_frd.q4) ||
+        !attitude_ned_frd.is_unit_length() || !std::isfinite(thrust_norm) ||
+        thrust_norm < 0.0f || thrust_norm > 1.0f) {
+        return false;
+    }
+    Quaternion attitude = attitude_ned_frd;
+    attitude.normalize(); // only remove accepted floating-point norm error
+    copter.mode_guided.set_angle(attitude, Vector3f(0.0f, 0.0f, 0.0f), thrust_norm, true);
+    return true;
+}
