+#if AP_DDS_WKSIM_ATTITUDE_ENABLED
+bool AP_DDS_External_Control::handle_attitude_control(const ardupilot_msgs_msg_WksimAttitudeTarget& target)
+{
+    auto *external_control = AP::externalcontrol();
+    const auto &q = target.orientation;
+    const auto &stamp = target.header.stamp;
+    if (external_control == nullptr || strcmp(target.header.frame_id, MAP_FRAME) != 0 ||
+        stamp.sec < 0 || stamp.nanosec >= 1000000000U ||
+        !std::isfinite(q.w) || !std::isfinite(q.x) || !std::isfinite(q.y) || !std::isfinite(q.z) ||
+        !std::isfinite(target.normalized_thrust) || target.normalized_thrust < 0.0f ||
+        target.normalized_thrust > 1.0f) {
+        return false;
+    }
+    const uint64_t stamp_us = uint64_t(stamp.sec) * 1000000U + stamp.nanosec / 1000U;
+    const uint64_t now_us = AP_HAL::micros64();
+    // Bound queued commands without changing the native Guided timeout.
+    if (stamp_us == 0 || stamp_us > now_us || now_us - stamp_us > 250000U) {
+        return false;
+    }
+    // Match AP_Math/quaternion.cpp: tolerance applies to squared norm.
+    const double norm_sq = q.w*q.w + q.x*q.x + q.y*q.y + q.z*q.z;
+    if (!std::isfinite(norm_sq) || fabs(norm_sq - 1.0) >= 1.0e-3) {
+        return false;
+    }
+    // R_NED_ENU * R_ENU_FLU * R_FLU_FRD, Hamilton WXYZ.
+    constexpr double k = 0.70710678118654752440;
+    Quaternion attitude_ned_frd(k*(q.w+q.z), k*(q.x+q.y), k*(q.x-q.y), k*(q.w-q.z));
+    return external_control->set_attitude_and_thrust(attitude_ned_frd, target.normalized_thrust);
+}
+#endif
