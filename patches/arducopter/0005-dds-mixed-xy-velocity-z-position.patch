+// NE uses native velocity control/avoidance; D uses native position control.
+void ModeGuided::vel_NE_pos_D_control_run()
+{
+    if (is_disarmed_or_landed()) {
+        make_safe_ground_handling(copter.is_tradheli() && motors->get_interlock());
+        return;
+    }
+    motors->set_desired_spool_state(AP_Motors::DesiredSpoolState::THROTTLE_UNLIMITED);
+
+    // Timeout stops XY motion but retains the accepted altitude target.
+    if (millis() - update_time_ms > get_timeout_ms()) {
+        guided_vel_target_ned_ms.zero();
+        guided_accel_target_ned_mss.zero();
+        if ((auto_yaw.mode() == AutoYaw::Mode::RATE) || (auto_yaw.mode() == AutoYaw::Mode::ANGLE_RATE)) {
+            auto_yaw.set_mode(AutoYaw::Mode::HOLD);
+        }
+    }
+
+    Vector3f velocity_ned_ms(guided_vel_target_ned_ms.x, guided_vel_target_ned_ms.y, 0.0f);
+    bool do_avoid = false;
+#if AP_AVOIDANCE_ENABLED
+    copter.avoid.adjust_velocity_NED_m(velocity_ned_ms, pos_control->NE_get_pos_p().kP(), pos_control->NE_get_max_accel_mss(), pos_control->D_get_pos_p().kP(), pos_control->D_get_max_accel_mss(), G_Dt);
+    do_avoid = copter.avoid.limits_active();
+#endif
+    // Only horizontal avoidance applies. Its Z output is never D feedforward.
+    if (!stabilizing_vel_NE() && !do_avoid) {
+        velocity_ned_ms.xy() = pos_control->get_vel_desired_NED_ms().xy();
+    }
+    pos_control->input_vel_accel_NE_m(velocity_ned_ms.xy(), Vector2f(), false);
+    if (!stabilizing_vel_NE() && !do_avoid) {
+        pos_control->NE_stop_vel_stabilisation();
+    } else if (!stabilizing_pos_NE() && !do_avoid) {
+        pos_control->NE_stop_pos_stabilisation();
+    }
+
+    if (guided_is_terrain_alt) {
+        INTERNAL_ERROR(AP_InternalError::error_t::flow_of_control);
+    }
+    float pz = guided_pos_target_ned_m.z;
+    float vz = 0.0f;
+    pos_control->input_pos_vel_accel_D_m(pz, vz, 0.0f, false);
+    guided_pos_target_ned_m.z = pz;
+
+    // Each axis consumes its own reset policy in its native update.
+    pos_control->set_reset_handling_method(AC_PosControl::EKFResetMethod::MoveTarget);
+    pos_control->NE_update_controller();
+    pos_control->set_reset_handling_method(AC_PosControl::EKFResetMethod::MoveVehicle);
+    pos_control->D_update_controller();
+    pos_control->set_reset_handling_method(AC_PosControl::EKFResetMethod::MoveTarget);
+    attitude_control->input_thrust_vector_heading(pos_control->get_thrust_vector(), auto_yaw.get_heading());
+}
