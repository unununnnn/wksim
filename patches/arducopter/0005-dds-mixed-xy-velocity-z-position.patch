+bool AP_ExternalControl_Copter::set_altitude_velocity_xy_and_yaw(int32_t altitude_above_home_cm,
+    const Vector2f& velocity_ne_ms, float yaw_rad)
+{
+    if (!ready_for_external_control() || !std::isfinite(velocity_ne_ms.x) ||
+        !std::isfinite(velocity_ne_ms.y) || !std::isfinite(yaw_rad)) {
+        return false;
+    }
+
+    auto &ahrs = AP::ahrs();
+    Location check_loc, origin;
+    if (!ahrs.get_location(check_loc) || !check_loc.initialised() ||
+        !ahrs.home_is_set() || !ahrs.get_origin(origin)) {
+        return false;
+    }
+    // Guard Location's int32 centimetre intermediates before the real conversion.
+    const int64_t absolute_cm = int64_t(altitude_above_home_cm) + ahrs.get_home().alt;
+    const int64_t origin_cm = absolute_cm - origin.alt;
+    if (absolute_cm < std::numeric_limits<int32_t>::min() || absolute_cm > std::numeric_limits<int32_t>::max() ||
+        origin_cm < std::numeric_limits<int32_t>::min() || origin_cm > std::numeric_limits<int32_t>::max()) {
+        return false;
+    }
+    check_loc.set_alt_cm(altitude_above_home_cm, Location::AltFrame::ABOVE_HOME);
+    float altitude_above_origin_m;
+    if (!check_loc.initialised() ||
+        !check_loc.get_alt_m(Location::AltFrame::ABOVE_ORIGIN, altitude_above_origin_m) ||
+        !std::isfinite(altitude_above_origin_m)) {
+        return false;
+    }
+    return copter.mode_guided.set_vel_NE_pos_D_m(velocity_ne_ms, -altitude_above_origin_m, yaw_rad);
+}
