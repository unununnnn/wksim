+bool ModeGuided::set_vel_NE_pos_D_m(const Vector2f& velocity_ne_ms, float position_d_m, float yaw_rad)
+{
+    const double altitude_cm = -double(position_d_m) * 100.0;
+    const double max_xy_speed = std::sqrt(double(std::numeric_limits<float>::max()) / 4.0) / 100.0;
+    if (_paused || !std::isfinite(velocity_ne_ms.x) || !std::isfinite(velocity_ne_ms.y) ||
+        !std::isfinite(position_d_m) || !std::isfinite(yaw_rad) ||
+        fabsf(velocity_ne_ms.x) > max_xy_speed || fabsf(velocity_ne_ms.y) > max_xy_speed ||
+        altitude_cm < std::numeric_limits<int32_t>::min() || altitude_cm > std::numeric_limits<int32_t>::max()) {
+        return false;
+    }
+
+    auto &location_ahrs = AP::ahrs();
+    Location check_loc, origin;
+    if (!location_ahrs.get_location(check_loc) || !check_loc.initialised() ||
+        !location_ahrs.home_is_set() || !location_ahrs.get_origin(origin)) {
+        return false;
+    }
+    const int32_t target_alt_cm = static_cast<int32_t>(altitude_cm);
+    const int64_t absolute_cm = int64_t(target_alt_cm) + origin.alt;
+    const int64_t home_cm = absolute_cm - location_ahrs.get_home().alt;
+    if (absolute_cm < std::numeric_limits<int32_t>::min() || absolute_cm > std::numeric_limits<int32_t>::max() ||
+        home_cm < std::numeric_limits<int32_t>::min() || home_cm > std::numeric_limits<int32_t>::max()) {
+        return false;
+    }
+    // The current geographic XY is used only for validation/fence checks.
+    check_loc.set_alt_cm(target_alt_cm, Location::AltFrame::ABOVE_ORIGIN);
+    float checked_alt_m;
+    if (!check_loc.initialised() ||
+        !check_loc.get_alt_m(Location::AltFrame::ABOVE_HOME, checked_alt_m) || !std::isfinite(checked_alt_m)) {
+        return false;
+    }
+#if AP_FENCE_ENABLED
+    // Fence itself skips failed altitude conversions: fail closed here first.
