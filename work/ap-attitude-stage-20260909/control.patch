+def command_quaternion(values):
+    """Hamilton WXYZ command; AP native abs(norm_squared - 1) < 1e-3."""
+    values = vector(values, 4)
+    norm_sq = sum(v*v for v in values)
+    if not math.isfinite(norm_sq) or abs(norm_sq - 1.0) >= 1e-3:
+        raise ValueError('Non-unit command quaternion')
+    return unit_quaternion(values)
 
 
