{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wksim.invalid/schemas/e0-current-source-mapping-v1.json",
  "title": "wksim e0 current-source mapping",
  "description": "Provenance-only per-slot map from the 56 dynamic contract slots to their root-outport write statements in the #70-generated SLX 11.8 C++. Not a numerical budget contract.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "status",
    "provenance_only",
    "non_claims",
    "contract",
    "generated_source",
    "derivation",
    "slot_count",
    "slots"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "e0_current_source_mapping"
    },
    "status": {
      "const": "bound"
    },
    "provenance_only": {
      "const": true
    },
    "non_claims": {
      "type": "string",
      "minLength": 1
    },
    "contract": {
      "$ref": "#/$defs/contract"
    },
    "generated_source": {
      "$ref": "#/$defs/generatedSource"
    },
    "derivation": {
      "$ref": "#/$defs/derivation"
    },
    "slot_count": {
      "const": 56
    },
    "slots": {
      "type": "array",
      "minItems": 56,
      "maxItems": 56,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/slot"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "lineRange": {
      "type": "array",
      "prefixItems": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "integer",
          "minimum": 1
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "contract_id", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "contract_id": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "generatedSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "model_version",
        "generation_run",
        "artifact_relative_path",
        "sha256",
        "size_bytes",
        "evidence"
      ],
      "properties": {
        "name": {
          "const": "Exp1_MinModelTemp.cpp"
        },
        "model_version": {
          "const": "11.8"
        },
        "generation_run": {
          "type": "string",
          "minLength": 1
        },
        "artifact_relative_path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256"],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        }
      }
    },
    "outportBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["array", "outport", "size"],
      "properties": {
        "array": {
          "enum": ["Vehicle60", "Sensor30", "GPS30"]
        },
        "outport": {
          "enum": ["VehileInfo60d", "HILSensor30d", "HILGPS30d"]
        },
        "size": {
          "enum": [30, 60]
        }
      }
    },
    "derivation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule",
        "line_numbering",
        "enclosing_function",
        "outports",
        "covered_output_slots"
      ],
      "properties": {
        "rule": {
          "const": "e0-current-outport-write-v1"
        },
        "line_numbering": {
          "const": "raw-bytes-split-lf"
        },
        "enclosing_function": {
          "const": "MulticopterModelClass::step"
        },
        "outports": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/outportBinding"
          }
        },
        "covered_output_slots": {
          "const": 120
        }
      }
    },
    "slot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slot",
        "array",
        "index",
        "observable",
        "outport",
        "statement",
        "line_ranges"
      ],
      "properties": {
        "slot": {
          "type": "string",
          "pattern": "^(Vehicle60|Sensor30|GPS30)\\[[0-9]+\\]$"
        },
        "array": {
          "enum": ["Vehicle60", "Sensor30", "GPS30"]
        },
        "index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 59
        },
        "observable": {
          "type": "string",
          "minLength": 1
        },
        "outport": {
          "enum": ["VehileInfo60d", "HILSensor30d", "HILGPS30d"]
        },
        "statement": {
          "enum": ["assignment", "memcpy"]
        },
        "line_ranges": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "$ref": "#/$defs/lineRange"
          }
        }
      }
    }
  }
}
