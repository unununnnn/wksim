{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wksim.invalid/schemas/e0-source-to-slot-manifest-v2.json",
  "title": "wksim e0 source-to-slot manifest",
  "description": "A provenance-only map for the 56 dynamic scalar slots. It is not a numerical budget contract.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "status",
    "contract",
    "model_source",
    "slot_count",
    "slots"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "kind": {
      "const": "e0_source_to_slot_manifest"
    },
    "status": {
      "enum": ["unresolved", "complete"]
    },
    "contract": {
      "$ref": "#/$defs/contract"
    },
    "model_source": {
      "$ref": "#/$defs/modelSource"
    },
    "slot_count": {
      "const": 56
    },
    "slots": {
      "type": "array",
      "minItems": 56,
      "maxItems": 56,
      "items": {
        "$ref": "#/$defs/slot"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nullableString": {
      "type": ["string", "null"]
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "contract_id", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "contract_id": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "archive": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "member", "member_sha256"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "member": {
          "type": "string",
          "minLength": 1
        },
        "member_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "modelSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["historical_r1_cpp", "current_slx_11_8"],
      "properties": {
        "historical_r1_cpp": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "model_version", "archive"],
          "properties": {
            "status": {
              "const": "bound"
            },
            "model_version": {
              "const": "11.0"
            },
            "archive": {
              "$ref": "#/$defs/archive"
            }
          }
        },
        "current_slx_11_8": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "model_version", "path", "sha256", "line_mapping", "unresolved_reason"],
          "properties": {
            "status": {
              "const": "unresolved"
            },
            "model_version": {
              "const": "11.8"
            },
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            },
            "line_mapping": {
              "const": null
            },
            "unresolved_reason": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "lineRange": {
      "type": "array",
      "prefixItems": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "integer",
          "minimum": 1
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "historicalMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "line_ranges"],
      "properties": {
        "status": {
          "const": "bound"
        },
        "line_ranges": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/lineRange"
          }
        }
      }
    },
    "currentMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "line_ranges"],
      "properties": {
        "status": {
          "const": "unresolved"
        },
        "line_ranges": {
          "const": null
        }
      }
    },
    "sourceMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["raw", "historical_r1_cpp", "current_slx_11_8"],
      "properties": {
        "raw": {
          "type": ["string", "null"]
        },
        "historical_r1_cpp": {
          "$ref": "#/$defs/historicalMapping"
        },
        "current_slx_11_8": {
          "$ref": "#/$defs/currentMapping"
        }
      }
    },
    "slot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slot",
        "array",
        "index",
        "observable",
        "source_mapping",
        "version",
        "hash",
        "unit",
        "frame",
        "datum",
        "sample_phase",
        "status",
        "unresolved_fields"
      ],
      "properties": {
        "slot": {
          "type": "string",
          "pattern": "^(Vehicle60|Sensor30|GPS30)\\[[0-9]+\\]$"
        },
        "array": {
          "enum": ["Vehicle60", "Sensor30", "GPS30"]
        },
        "index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 59
        },
        "observable": {
          "type": "string",
          "minLength": 1
        },
        "source_mapping": {
          "$ref": "#/$defs/sourceMapping"
        },
        "version": {
          "$ref": "#/$defs/nullableString"
        },
        "hash": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$"
        },
        "unit": {
          "$ref": "#/$defs/nullableString"
        },
        "frame": {
          "$ref": "#/$defs/nullableString"
        },
        "datum": {
          "$ref": "#/$defs/nullableString"
        },
        "sample_phase": {
          "$ref": "#/$defs/nullableString"
        },
        "status": {
          "enum": ["unresolved", "complete"]
        },
        "unresolved_fields": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
