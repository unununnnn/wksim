+bool AP_ExternalControl_Copter::set_global_position_velocity_and_yaw(const Location& loc,
+    const Vector3f& velocity_ned_ms, bool use_yaw, float yaw_rad)
+{
+    if (!ready_for_external_control() ||
+        !std::isfinite(velocity_ned_ms.x) || !std::isfinite(velocity_ned_ms.y) ||
+        !std::isfinite(velocity_ned_ms.z) || (use_yaw && !std::isfinite(yaw_rad))) {
+        return false;
+    }
+    // Location resolves the requested height frame against the EKF origin,
+    // including failure when origin/home/terrain data needed for conversion is absent.
+    Vector3p position_ned_m;
+    if (!loc.get_vector_from_origin_NED_m(position_ned_m) ||
+        !std::isfinite(position_ned_m.x) || !std::isfinite(position_ned_m.y) ||
+        !std::isfinite(position_ned_m.z)) {
+        return false;
+    }
+    // Native Guided retains fence validation, target timestamp and timeout handling.
+    return copter.mode_guided.set_pos_vel_NED_m(position_ned_m, velocity_ned_ms,
+                                               use_yaw, use_yaw ? yaw_rad : 0.0f, false, 0.0f, false);
+}
