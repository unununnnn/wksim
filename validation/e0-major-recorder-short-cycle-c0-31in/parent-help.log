                        sers\PC\Documents\odid编译\wksim\tools\generated_e0_post
                        _reference.cpp)
  --build-id BUILD_ID   Identifier for this build run (^[a-zA-Z0-9_-]+$)
  --evidence-dir EVIDENCE_DIR
                        Explicit destination directory for evidence artifacts
                        in validation/
  --evidence-root EVIDENCE_ROOT
                        Root directory for build evidence (default:
                        C:\Users\PC\Documents\odid编译\wksim\validation)
  --wsl-distro WSL_DISTRO
                        WSL distribution name (default: Ubuntu-22.04)
  --wsl-user WSL_USER   WSL username (default: root)
  --wsl-build-dir WSL_BUILD_DIR
                        Explicit WSL build directory (default:
                        /root/wksim-e0-major-<build_id>)
  --record-input RECORD_INPUT
                        Path to 501-row input CSV (e.g. validation/numerical-
                        contract-20260909/inputs/C0.csv)
  --reference-lib REFERENCE_LIB
                        Path in WSL to reference (.so shared library or
                        .jsonl). If omitted, uses built-in 31-input reference
                        executable
  --reference-manifest REFERENCE_MANIFEST
                        Path to reference build-manifest.json for source and
                        SHA verification (default: C:\Users\PC\Documents\odid编
